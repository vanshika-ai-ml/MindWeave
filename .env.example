# ========================================================
# MindWeave Environment Configuration Template
# ========================================================

# Google Gemini API
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
# Local Docker Postgres: postgresql://mindweave_user:mindweave_password@localhost:5432/mindweave_db
# Local SQLite fallback: sqlite:///./mindweave.db
# Production (Neon): postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./mindweave.db

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend (in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
